<script>
// ===== SLIDE ENGINE =====
const slides = document.querySelectorAll('.slide');
const total = slides.length;
let cur = 0;

function renderSlides(dir) {
  slides.forEach((s, i) => {
    s.classList.remove('active','prev');
    if (i === cur) s.classList.add('active');
    else if (i < cur) s.classList.add('prev');
  });
  // Progress
  document.getElementById('progressFill').style.width = ((cur/(total-1))*100) + '%';
  // Dots
  const dc = document.getElementById('dots');
  dc.innerHTML = '';
  slides.forEach((_,i) => {
    const d = document.createElement('div');
    d.className = 'dot' + (i===cur?' active':'');
    d.onclick = () => { cur=i; renderSlides(); };
    dc.appendChild(d);
  });
  document.getElementById('slideNum').textContent = (cur+1) + ' / ' + total;
  document.getElementById('btnPrev').disabled = cur === 0;
  document.getElementById('btnNext').disabled = cur === total-1;
}

function go(dir) {
  const next = cur + dir;
  if (next < 0 || next >= total) return;
  cur = next;
  renderSlides();
}

document.addEventListener('keydown', e => {
  if (e.key === 'ArrowRight' || e.key === 'ArrowDown' || e.key === ' ') { e.preventDefault(); go(1); }
  if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { e.preventDefault(); go(-1); }
});

// Touch swipe
let tx = 0;
document.addEventListener('touchstart', e => tx = e.touches[0].clientX, {passive:true});
document.addEventListener('touchend', e => {
  const dx = tx - e.changedTouches[0].clientX;
  if (Math.abs(dx) > 50) go(dx > 0 ? 1 : -1);
}, {passive:true});

renderSlides();

// ===== QUIZ =====
const qs = [
  { q:"Yangi texnologiya o'rganishda qanday yondashасiz?", opts:[
    {t:"YouTube video ko'rib, vizual tushunaman", s:{frontend:3,ai:1}},
    {t:"Hujjat va kitobdan chuqur o'qiyman", s:{backend:3,cyber:2,ai:2}},
    {t:"Amaliyot qilib, sinab ko'raman", s:{devops:3,frontend:2}},
    {t:"Muammo bo'lganda zarur narsani o'rganaman", s:{backend:2,devops:2}}
  ]},
  { q:"Qaysi faoliyat sizga ko'proq qiziqarli?", opts:[
    {t:"Chiroyli interfeys va dizayn yaratish", s:{frontend:4}},
    {t:"Ma'lumotlar va tizimlar bilan ishlash", s:{backend:4,ai:1}},
    {t:"Serverlar barqarorligini ta'minlash", s:{devops:4}},
    {t:"Tizim zaifliklarini topish va himoya", s:{cyber:4}}
  ]},
  { q:"Matematikaga munosabatingiz?", opts:[
    {t:"Yaxshi ko'raman, qiziqaman", s:{ai:4,backend:1}},
    {t:"O'rtacha — kerak bo'lsa o'rganaman", s:{backend:2,devops:2,frontend:2}},
    {t:"Unchalik emas, lekin mantiqqa kuchliman", s:{cyber:3,devops:2}},
    {t:"Matematik emas, vizual fikrlayman", s:{frontend:4}}
  ]},
  { q:"Sabr va chidam nuqtai nazaridan:", opts:[
    {t:"Bir muammoni soatlab o'tiraman", s:{cyber:3,ai:3,backend:2}},
    {t:"Natija ko'rsam, davom etaman", s:{frontend:3,devops:2}},
    {t:"Tez natija kerak", s:{frontend:2}},
    {t:"Muammo yechish menga kuch beradi", s:{cyber:4,backend:3}}
  ]},
  { q:"Kelajak maqsadingiz?", opts:[
    {t:"Remote ishlash, xorijiy kompaniya", s:{backend:3,devops:3,ai:3}},
    {t:"O'z startapimni qurish", s:{frontend:3,backend:3}},
    {t:"Davlat/bank IT xavfsizligida ishlash", s:{cyber:4}},
    {t:"Tadqiqot va ilm bilan shug'ullanish", s:{ai:4}}
  ]}
];
let qc=0, qsel=new Array(5).fill(null);

function qRender(){
  document.getElementById('qN').textContent=`Savol ${qc+1} / ${qs.length}`;
  document.getElementById('qT').textContent=qs[qc].q;
  document.getElementById('qPrev').style.display=qc>0?'block':'none';
  document.getElementById('qNext').textContent=qc===qs.length-1?'Natijani ko\'rish ✓':'Keyingi →';
  const o=document.getElementById('qO'); o.innerHTML='';
  qs[qc].opts.forEach((opt,i)=>{
    const d=document.createElement('div');
    d.className='qopt'+(qsel[qc]===i?' sel':'');
    d.innerHTML=`<span class="qoptkey">${String.fromCharCode(65+i)}</span>${opt.t}`;
    d.onclick=()=>{
      document.querySelectorAll('.qopt').forEach(el=>el.classList.remove('sel'));
      d.classList.add('sel'); qsel[qc]=i;
    };
    o.appendChild(d);
  });
  const dots=document.querySelectorAll('.pd');
  dots.forEach((d,i)=>d.classList.toggle('done',i<=qc));
}

function qNext(){
  if(qsel[qc]===null){
    const o=document.getElementById('qO');
    o.style.opacity='0.4'; setTimeout(()=>o.style.opacity='1',400); return;
  }
  if(qc<qs.length-1){qc++;qRender();}
  else{
    const sc={frontend:0,backend:0,devops:0,cyber:0,ai:0};
    qsel.forEach((sel,qi)=>{
      if(sel!==null){const s=qs[qi].opts[sel].s;Object.keys(s).forEach(k=>sc[k]=(sc[k]||0)+s[k]);}
    });
    const sorted=Object.entries(sc).sort((a,b)=>b[1]-a[1]);
    const top=sorted[0][0];
    const res={
      frontend:{icon:'🎨',type:'Frontend Developer',desc:'Vizual fikrlovchi, foydalanuvchi tajribasiga e\'tiborli. HTML/CSS/JS/React yo\'li sizga mos. Yaratuvchi va ijodiy fikrlovchilar uchun ideal tanlov.'},
      backend:{icon:'⚙️',type:'Backend Developer',desc:'Tizimli fikrlovchi, ma\'lumotlar va mantiq bilan ishlashni yaxshi ko\'rasiz. Python/Django yoki Java/Spring — bu sizning dunyoyingiz.'},
      devops:{icon:'🚀',type:'DevOps Engineer',desc:'Tizimlarni avtomatlashtirish va barqarorlikka e\'tiborli insofsiz. Linux, Docker, Kubernetes va cloud — bu sizning sayohatingiz.'},
      cyber:{icon:'🔐',type:'Cybersecurity Specialist',desc:'Analitik fikrlovchi, sabr-toqatli. Ethical hacking, penetration testing — sirni topish sizga quvonch beradi.'},
      ai:{icon:'🤖',type:'AI/ML Engineer',desc:'Ilmiy fikrlovchi, statistika va ma\'lumotlar bilan ishlashni yaxshi ko\'rasiz. Python, ML modellari, chuqur o\'rganish — bu sizning yo\'lingiz.'}
    };
    const r=res[top];
    document.getElementById('qBody').style.display='none';
    const qr=document.getElementById('qRes'); qr.style.display='block';
    document.getElementById('rIcon').textContent=r.icon;
    document.getElementById('rType').textContent=r.type;
    document.getElementById('rDesc').textContent=r.desc;
    const tc={frontend:'var(--frontend)',backend:'var(--backend)',devops:'var(--devops)',cyber:'var(--cyber)',ai:'var(--ai)'};
    const tn={frontend:'Frontend',backend:'Backend',devops:'DevOps',cyber:'Cyber',ai:'AI/ML'};
    document.getElementById('rTags').innerHTML=sorted.slice(0,3).map(([k])=>`<span class="rtag" style="color:${tc[k]};border-color:${tc[k]}">${tn[k]}</span>`).join('');
  }
}
function qPrev(){if(qc>0){qc--;qRender();}}
function qReset(){qc=0;qsel=new Array(5).fill(null);document.getElementById('qBody').style.display='block';document.getElementById('qRes').style.display='none';qRender();}
qRender();
</script>

